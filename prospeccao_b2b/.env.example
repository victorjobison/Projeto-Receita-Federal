# 1. Dados de conexao com o PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prospeccao_db
DB_USER=postgres
DB_PASSWORD=postgres

# 2. Segredo usado pela sessao Flask; troque em ambiente real.
FLASK_SECRET=troque_essa_chave

# 3. Endpoint base usado para consultar dados de CNPJ.
BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1

# 4. Limite de itens por pagina, limitado no codigo a no maximo 50.
PAGE_SIZE=50

# 5. Credenciais do administrador criado pelo init_db.py.
ADMIN_EMAIL=admin@prospeccao.local
ADMIN_PASSWORD=admin123

# 6. Configuracao usada para assinar tokens JWT da API.
JWT_SECRET=troque_essa_chave_jwt
JWT_ALGORITHM=HS256
